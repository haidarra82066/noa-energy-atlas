---
import BaseLayout from "../layouts/BaseLayout.astro";
import { metrics, resolveSources } from "../data/atlas";
import { evidenceTypeAr, metricAr, precisionAr } from "../data/localization";
const groups=[...new Set(metrics.map((m)=>m.segment))];
---
<BaseLayout title="Market briefing" description="A caveated market briefing on Lebanon’s renewable-energy capacity, targets, finance and implementation signals.">
  <header class="page-head"><div><p class="eyebrow" data-en="Capacity, finance and delivery" data-ar="القدرة والتمويل والتنفيذ">Capacity, finance and delivery</p><h1 data-en="Market briefing" data-ar="إحاطة السوق">Market briefing</h1><p data-en="Current official estimates sit beside policy targets and investment models - but never in the same evidence bucket." data-ar="تُعرض التقديرات الرسمية الحالية إلى جانب أهداف السياسات ونماذج الاستثمار، من دون خلط أنواع الأدلة.">Current official estimates sit beside policy targets and investment models - but never in the same evidence bucket.</p></div><p class="cutoff"><strong data-en="Unit rule" data-ar="قاعدة الوحدات">Unit rule</strong><br /><span data-en="MW denotes capacity. GWh denotes energy. Approved, licensed, estimated and commissioned assets are not interchangeable." data-ar="يشير MW إلى القدرة وGWh إلى الطاقة. الأصول الموافق عليها أو المرخّصة أو المقدّرة أو الموضوعة في الخدمة ليست مترادفة.">MW denotes capacity. GWh denotes energy. Approved, licensed, estimated and commissioned assets are not interchangeable.</span></p></header>
  <div class="grid grid-3">{metrics.map((metric)=>{const ar=metricAr[metric.id];return <article class="card metric-card"><div class="number">{metric.value.toLocaleString("en-US")}</div><div class="unit">{metric.unit} · {metric.period}</div><h2 class="segment" data-en={metric.label} data-ar={ar?.label}>{metric.label}</h2><div class="meta"><span class="pill" data-en={metric.precision} data-ar={precisionAr[metric.precision]}>{metric.precision}</span><span data-en={metric.evidenceType} data-ar={evidenceTypeAr[metric.evidenceType]}>{metric.evidenceType}</span></div>{metric.note&&<p data-en={metric.note} data-ar={ar?.note}>{metric.note}</p>}<small><span data-en="Source:" data-ar="المصدر:">Source:</span> {resolveSources(metric.sourceIds).map((s)=><a href={s.url}>{s.publisher}</a>)}</small></article>})}</div>
  <h2 data-en="What the numbers say - and do not say" data-ar="ما الذي تقوله الأرقام وما الذي لا تقوله">What the numbers say - and do not say</h2>
  <div class="grid grid-2">
    <article class="card"><h3 data-en="Distributed solar has become material" data-ar="أصبحت الطاقة الشمسية الموزعة ذات وزن ملموس">Distributed solar has become material</h3><p data-en="The NREAP estimates 1,190 MW of distributed PV in 2024. That is an official planning estimate, not a continuously reconciled national asset registry. Other studies use different totals and methods." data-ar="تقدّر الخطة الوطنية القدرة الشمسية الموزعة بنحو 1,190 ميغاواط في 2024. وهو تقدير تخطيطي رسمي، لا سجل وطني حيّاً ومطابقاً بصورة مستمرة. تستخدم دراسات أخرى مجاميع وأساليب مختلفة.">The NREAP estimates 1,190 MW of distributed PV in 2024. That is an official planning estimate, not a continuously reconciled national asset registry. Other studies use different totals and methods.</p></article>
    <article class="card"><h3 data-en="Scenarios remain conditional" data-ar="تبقى السيناريوهات مشروطة">Scenarios remain conditional</h3><p data-en="The NREAP Realistic Scenario reaches 40% renewables by 2030. It depends on demand, reforms, finance, grids and projects. The Atlas therefore labels it “scenario,” not “forecast.”" data-ar="يبلغ السيناريو الواقعي في الخطة 40% من الطاقة المتجددة بحلول 2030. ويتوقف على الطلب والإصلاح والتمويل والشبكة والمشاريع؛ لذلك يصنفه الأطلس سيناريو لا توقعاً.">The NREAP Realistic Scenario reaches 40% renewables by 2030. It depends on demand, reforms, finance, grids and projects. The Atlas therefore labels it “scenario,” not “forecast.”</p></article>
    <article class="card"><h3 data-en="Investment models reveal risk costs" data-ar="تكشف نماذج الاستثمار كلفة المخاطر">Investment models reveal risk costs</h3><p data-en="UNDP’s updated DREI model estimates how public measures could reduce financing costs. Its USD 743 million figure is modeled private investment, not a committed pipeline." data-ar="يقدّر نموذج خفض المخاطر المحدّث كيف يمكن للتدابير العامة تقليل كلفة التمويل. رقم 743 مليون دولار استثمار خاص منمذج، وليس محفظة مشاريع ملتزماً بها.">UNDP’s updated DREI model estimates how public measures could reduce financing costs. Its USD 743 million figure is modeled private investment, not a committed pipeline.</p></article>
    <article class="card"><h3 data-en="Licensing is an intermediate milestone" data-ar="الترخيص محطة وسيطة">Licensing is an intermediate milestone</h3><p data-en="The 165 MW solar cohort received Cabinet approvals in 2022. Readers should verify PPA effectiveness, financial close, construction and commissioning separately." data-ar="حصلت دفعة مشاريع الطاقة الشمسية بقدرة 165 ميغاواط على موافقة مجلس الوزراء في 2022. ويجب التحقق بصورة منفصلة من نفاذ اتفاقيات شراء الطاقة والإقفال المالي والبناء والوضع في الخدمة.">The 165 MW solar cohort received Cabinet approvals in 2022. Readers should verify PPA effectiveness, financial close, construction and commissioning separately.</p></article>
  </div>
  <p class="method-note"><span data-en="Segments represented in the metric ledger:" data-ar="الشرائح الممثلة في سجل المؤشرات:">Segments represented in the metric ledger:</span> {groups.join("; ")}.</p>
</BaseLayout>
