---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceList from "../../components/SourceList.astro";
import { claimById, instruments, relationships, instrumentById, news } from "../../data/atlas";
import { legalDetails } from "../../data/legal-details";
import { categoryAr, claimAr, confidenceAr, evidenceTypeAr, instrumentAr, jurisdictionAr, newsAr, precisionAr, relationshipAr, statusAr } from "../../data/localization";
export function getStaticPaths(){ return instruments.map((instrument)=>({params:{slug:instrument.slug},props:{instrument}})); }
const { instrument } = Astro.props;
const claims=instrument.claimIds.flatMap((id:string)=>{const c=claimById.get(id);return c?[c]:[];});
const links=relationships.filter((rel)=>rel.from===instrument.id||rel.to===instrument.id);
const sourceIds=[...new Set([...instrument.sourceIds,...claims.flatMap((claim)=>claim.sourceIds),...links.flatMap((rel)=>rel.sourceIds)])];
const ar=instrumentAr[instrument.id];
const legal=legalDetails[instrument.id];
const updates=news.filter((item)=>item.instrumentIds.includes(instrument.id));
const basePath=import.meta.env.BASE_URL.replace(/\/$/,"");
const statusTone=instrument.status === "In force" ? "live" : instrument.status === "Under implementation" || instrument.status === "Operational programme" ? "progress" : instrument.status === "Project" ? "project" : instrument.status === "Draft" ? "draft" : instrument.status === "Voluntary commitment" ? "commitment" : instrument.status === "Policy" ? "policy" : "historic";
---
<BaseLayout title={instrument.shortTitle} description={instrument.summary}>
  <p class="eyebrow"><span data-en={instrument.category} data-ar={categoryAr[instrument.category]}>{instrument.category}</span> · <span data-en={instrument.jurisdiction} data-ar={jurisdictionAr[instrument.jurisdiction]}>{instrument.jurisdiction}</span></p>
  <header class="page-head"><div><h1 data-en={instrument.title} data-ar={ar?.title}>{instrument.title}</h1><p data-en={instrument.summary} data-ar={ar?.summary}>{instrument.summary}</p></div><div class="cutoff"><span class="pill status-pill" data-tone={statusTone} data-en={instrument.status} data-ar={statusAr[instrument.status]}>{instrument.status}</span><br /><span data-en="Last reviewed" data-ar="آخر مراجعة">Last reviewed</span> <time datetime={instrument.lastReviewed}>{instrument.lastReviewed}</time></div></header>
  <div class="detail-grid">
    <article>
      <section class="legal-overview" aria-label="Legal overview" data-aria-en="Legal overview" data-aria-ar="نظرة قانونية عامة">
        <div><span data-en="Official record" data-ar="السجل الرسمي">Official record</span><strong data-en={instrument.title} data-ar={ar?.title}>{instrument.title}</strong></div>
        <div><span data-en="Legal character" data-ar="الطبيعة القانونية">Legal character</span><strong data-en={legal?.natureEn || instrument.status} data-ar={legal?.natureAr || statusAr[instrument.status]}>{legal?.natureEn || instrument.status}</strong></div>
        <div><span data-en="Current reading" data-ar="القراءة الحالية">Current reading</span><strong data-en={instrument.status === "In force" ? "Operative" : instrument.status} data-ar={statusAr[instrument.status]}>{instrument.status === "In force" ? "Operative" : instrument.status}</strong></div>
      </section>
      {legal?.scopeEn && <section class="scope-statement"><span data-en="Scope and applicability" data-ar="النطاق والانطباق">Scope and applicability</span><p data-en={legal.scopeEn} data-ar={legal.scopeAr}>{legal.scopeEn}</p></section>}
      <h2 data-en="Why it matters" data-ar="لماذا يهم">Why it matters</h2><p class="lede" data-en={instrument.whyItMatters} data-ar={ar?.whyItMatters}>{instrument.whyItMatters}</p>
      {legal && <section class="provision-section"><h2 data-en="Core provisions" data-ar="الأحكام الأساسية">Core provisions</h2><p class="section-note" data-en="The operative ideas to understand before reading the full text." data-ar="الأفكار الأساسية التي ينبغي فهمها قبل قراءة النص الكامل.">The operative ideas to understand before reading the full text.</p><ol class="provision-list">{legal.provisionsEn.map((provision,index)=><li><span>{String(index+1).padStart(2,"0")}</span><p data-en={provision} data-ar={legal.provisionsAr[index]}>{provision}</p></li>)}</ol><aside class="implementation-watch"><i class="ph ph-eye" aria-hidden="true"></i><div><strong data-en="Implementation watch" data-ar="متابعة التنفيذ">Implementation watch</strong><p data-en={legal.watchEn} data-ar={legal.watchAr}>{legal.watchEn}</p></div></aside></section>}
      {legal?.engineeringEn && legal?.economicsEn && <section class="professional-lenses" aria-label="Professional interpretation" data-aria-en="Professional interpretation" data-aria-ar="القراءة المهنية">
        <article><i class="ph ph-lightning" aria-hidden="true"></i><h2 data-en="Engineering lens" data-ar="المنظور الهندسي">Engineering lens</h2><ul>{legal.engineeringEn.map((item,index)=><li data-en={item} data-ar={legal.engineeringAr?.[index]}>{item}</li>)}</ul></article>
        <article><i class="ph ph-chart-line-up" aria-hidden="true"></i><h2 data-en="Economic and investment lens" data-ar="المنظور الاقتصادي والاستثماري">Economic and investment lens</h2><ul>{legal.economicsEn.map((item,index)=><li data-en={item} data-ar={legal.economicsAr?.[index]}>{item}</li>)}</ul></article>
      </section>}
      {legal?.implementationEn && <section class="implementation-gates"><div><p class="eyebrow" data-en="From text to operation" data-ar="من النص إلى التشغيل">From text to operation</p><h2 data-en="Implementation gates" data-ar="بوابات التنفيذ">Implementation gates</h2><p data-en="These conditions must be evidenced before treating the instrument as operational for a project, tariff or market transaction." data-ar="يجب إثبات هذه الشروط قبل اعتبار الأداة تشغيلية لمشروع أو تعرفة أو معاملة سوقية.">These conditions must be evidenced before treating the instrument as operational for a project, tariff or market transaction.</p></div><ol>{legal.implementationEn.map((item,index)=><li><span>{index+1}</span><strong data-en={item} data-ar={legal.implementationAr?.[index]}>{item}</strong></li>)}</ol></section>}
      {claims.length>0 && <><h2 data-en="Verified claims" data-ar="ادعاءات متحقق منها">Verified claims</h2>{claims.map((claim)=>{const car=claimAr[claim.id];return <blockquote class="claim"><p data-en={claim.text} data-ar={car?.text}>{claim.text}</p><footer><span data-en={claim.evidenceType} data-ar={evidenceTypeAr[claim.evidenceType]}>{claim.evidenceType}</span> · <span data-en={claim.precision} data-ar={precisionAr[claim.precision]}>{claim.precision}</span> · <span data-en={`${claim.confidence} confidence`} data-ar={`ثقة ${confidenceAr[claim.confidence]}`}>{claim.confidence} confidence</span> · <span data-en="as of" data-ar="كما في">as of</span> {claim.asOf}{claim.caveat && <><br /><strong data-en="Caveat:" data-ar="تنبيه:">Caveat:</strong> <span data-en={claim.caveat} data-ar={car?.caveat}>{claim.caveat}</span></>}</footer></blockquote>})}</>}
      <h2 data-en="Documented relationships" data-ar="العلاقات الموثقة">Documented relationships</h2>
      {links.length ? <ul>{links.map((rel)=>{const other=instrumentById.get(rel.from===instrument.id?rel.to:rel.from);return <li><strong data-en={rel.from===instrument.id?"This instrument":"Linked instrument"} data-ar={rel.from===instrument.id?"هذه الأداة":"الأداة المرتبطة"}>{rel.from===instrument.id?"This instrument":"Linked instrument"}</strong> <span data-en={rel.label} data-ar={relationshipAr[rel.id]}>{rel.label}</span> <a href={`${basePath}/instruments/${other?.slug}/`} data-en={other?.shortTitle} data-ar={other?instrumentAr[other.id]?.shortTitle:""}>{other?.shortTitle}</a></li>})}</ul> : <p data-en="No relationship is currently documented in the ledger." data-ar="لا توجد علاقة موثقة حالياً في السجل.">No relationship is currently documented in the ledger.</p>}
      {updates.length>0&&<section><h2 data-en="Updates affecting this record" data-ar="تحديثات تؤثر في هذا السجل">Updates affecting this record</h2><div class="instrument-updates">{updates.map((item)=><a href={`${basePath}/updates/#${item.slug}`}><time datetime={item.date}>{item.date}</time><span data-en={item.title} data-ar={newsAr[item.id]?.title}>{item.title}</span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>)}</div></section>}
      <SourceList ids={sourceIds} />
    </article>
    <aside class="sidebar card" aria-label="Instrument facts"><h2 data-en="Record" data-ar="السجل">Record</h2><dl class="fact-list"><div><dt data-en="Year" data-ar="السنة">Year</dt><dd>{instrument.year}</dd></div><div><dt data-en="Category" data-ar="المجال">Category</dt><dd data-en={instrument.category} data-ar={categoryAr[instrument.category]}>{instrument.category}</dd></div><div><dt data-en="Status" data-ar="الحالة">Status</dt><dd data-en={instrument.status} data-ar={statusAr[instrument.status]}>{instrument.status}</dd></div><div><dt data-en="Jurisdiction" data-ar="النطاق">Jurisdiction</dt><dd data-en={instrument.jurisdiction} data-ar={jurisdictionAr[instrument.jurisdiction]}>{instrument.jurisdiction}</dd></div><div><dt data-en="Primary records" data-ar="السجلات الأساسية">Primary records</dt><dd>{sourceIds.length}</dd></div><div><dt data-en="Ledger ID" data-ar="معرّف السجل">Ledger ID</dt><dd><code>{instrument.id}</code></dd></div></dl>{legal?.verificationEn && <div class="verification-note"><i class="ph ph-seal-check" aria-hidden="true"></i><div><strong data-en="Verification basis" data-ar="أساس التحقق">Verification basis</strong><p data-en={legal.verificationEn} data-ar={legal.verificationAr}>{legal.verificationEn}</p></div></div>}<p class="method-note" data-en="Status describes the source record as reviewed on 16 August 2026. Verify the current official text before a transaction or design decision. This briefing is not legal advice." data-ar="تصف الحالة السجل كما تمت مراجعته في 16 آب 2026. تحقّق من النص الرسمي الحالي قبل أي معاملة أو قرار تصميم. هذه الإحاطة ليست مشورة قانونية.">Status describes the source record as reviewed on 16 August 2026. Verify the current official text before a transaction or design decision. This briefing is not legal advice.</p></aside>
  </div>
</BaseLayout>
