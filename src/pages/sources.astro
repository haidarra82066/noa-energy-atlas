---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sources } from "../data/atlas";
const ordered=[...sources].sort((a,b)=>(b.publishedAt??"").localeCompare(a.publishedAt??""));
const kindAr:Record<string,string>={law:"قانون",regulator:"تنظيمي",policy:"سياسة",research:"بحث",project:"مشروع","official-data":"بيانات رسمية",event:"حدث"};
const languageAr:Record<string,string>={Arabic:"العربية",English:"الإنكليزية",French:"الفرنسية"};
---
<BaseLayout title="Source register" description="Primary and research sources used by Noa Energy Atlas, with publisher, date, language and access metadata.">
  <header class="page-head"><div><p class="eyebrow" data-en="Provenance ledger" data-ar="سجل المنشأ">Provenance ledger</p><h1 data-en="Source register" data-ar="سجل المصادر">Source register</h1><p data-en="Every source currently admitted to the public data model. Original publication titles remain unchanged." data-ar="جميع المصادر المدرجة حالياً في نموذج البيانات العام. تبقى عناوين المنشورات الأصلية من دون تغيير.">Every source currently admitted to the public data model. Original publication titles remain unchanged.</p></div><p class="cutoff"><strong>{sources.length} <span data-en="sources" data-ar="مصدرًا">sources</span></strong><br /><span data-en="All URLs accessed 16 August 2026." data-ar="تم الدخول إلى جميع الروابط في 16 آب 2026.">All URLs accessed 16 August 2026.</span></p></header>
  <div class="table-scroll"><table class="relationship-table"><caption class="visually-hidden" data-en="Source register" data-ar="سجل المصادر">Source register</caption><thead><tr><th scope="col"><span data-en="Date" data-ar="التاريخ">Date</span></th><th scope="col"><span data-en="Source" data-ar="المصدر">Source</span></th><th scope="col"><span data-en="Publisher" data-ar="الناشر">Publisher</span></th><th scope="col"><span data-en="Type" data-ar="النوع">Type</span></th><th scope="col"><span data-en="Language" data-ar="اللغة">Language</span></th></tr></thead><tbody>{ordered.map((source)=><tr id={source.id}><td data-label="Date" data-label-ar="التاريخ">{source.publishedAt ? <time datetime={source.publishedAt}>{source.publishedAt}</time> : <span data-en="Not stated" data-ar="غير مذكور">Not stated</span>}</td><td data-label="Source" data-label-ar="المصدر"><a href={source.url} rel="external">{source.title} <i class="ph ph-arrow-square-out" aria-hidden="true"></i></a>{source.note&&<small>{source.note}</small>}</td><td data-label="Publisher" data-label-ar="الناشر">{source.publisher}</td><td data-label="Type" data-label-ar="النوع"><span class="pill" data-en={source.kind} data-ar={kindAr[source.kind]??source.kind}>{source.kind}</span></td><td data-label="Language" data-label-ar="اللغة"><span data-en={source.language} data-ar={languageAr[source.language]??source.language}>{source.language}</span></td></tr>)}</tbody></table></div>
</BaseLayout>
