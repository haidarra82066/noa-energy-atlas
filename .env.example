# Optional structured-analysis provider. Live evidence collection and change
# detection work without it; no synthetic briefing is generated in that case.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_API_KEY=

# Comma-separated URLs for a narrow on-demand research run.
INTELLIGENCE_EXTRA_URLS=
INTELLIGENCE_FETCH_CONCURRENCY=6

# Astro/Netlify canonical site URL. Netlify sets URL automatically in production.
URL=https://noa-energy-atlas.netlify.app

# GitHub Actions secret names used by the unattended publishers. Keep values
# blank here; configure them only in the dedicated repository settings.
INTELLIGENCE_API_KEY=
INTELLIGENCE_MODEL=
INTELLIGENCE_BASE_URL=https://api.openai.com/v1
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=ffdfa234-6474-4155-af51-7e08c6b6c3b9
